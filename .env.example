# Copy to .env and fill in. Never commit .env.

# --- LLM: Google Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ANALYZE_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2

# --- Embeddings + reranker: Voyage AI (https://dash.voyageai.com) ---
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4
VOYAGE_RERANK_MODEL=rerank-3

# --- Persistence: Neon Postgres (https://neon.tech) — chat history, unanswered log, leads ---
# Use the pooled connection string, e.g. postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Tracing + eval: LangSmith (https://smith.langchain.com) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=placidway-chatbot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Admin (protects the "Refresh now" button in the Streamlit sidebar) ---
ADMIN_TOKEN=

# --- Crawler identity (robots.txt etiquette) ---
CRAWLER_USER_AGENT=PlacidWayAssessmentBot/1.0 (+https://github.com/M-Tayyab-AI/placidway-knowledge-chatbot)
CRAWL_DELAY_SECONDS=1.0

# --- Optional: Cohere reranker (only for the reranker comparison; https://dashboard.cohere.com/api-keys) ---
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro
RERANKER=cohere
GEMINI_THINKING_LEVEL=low
