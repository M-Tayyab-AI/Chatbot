# Streamlit Community Cloud -> your app -> Settings -> Secrets: paste this with your own values.
# (Locally the app reads .env instead; never commit a real .streamlit/secrets.toml.)
# Every key is a top-level string; streamlit_app.py copies them into the environment, where the app's settings read them.

# --- Required ---
GOOGLE_API_KEY = ""                 # Gemini, https://aistudio.google.com/apikey
VOYAGE_API_KEY = ""                 # query embeddings, https://dash.voyageai.com
COHERE_API_KEY = ""                 # reranker, https://dashboard.cohere.com/api-keys

# --- Strongly recommended ---
DATABASE_URL = ""                   # Neon *pooled* connection string (chat history, leads, unanswered log)
ADMIN_TOKEN = ""                    # unlocks the sidebar Admin panel (refresh, logs, leads)

# --- Optional: LangSmith tracing ---
LANGSMITH_API_KEY = ""
LANGSMITH_PROJECT = "placidway-chatbot"
LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"

# --- Models and retrieval (defaults shown; only set to change them) ---
GEMINI_MODEL = "gemini-3.5-flash"
GEMINI_ANALYZE_MODEL = "gemini-3.5-flash-lite"
GEMINI_FALLBACK_MODEL = "gemini-3.5-flash-lite"
GEMINI_TEMPERATURE = "0.2"
RERANKER = "cohere"
COHERE_RERANK_MODEL = "rerank-v4.0-pro"
VOYAGE_EMBED_MODEL = "voyage-4"

# --- Crawler identity, used by the Admin "Refresh content now" button ---
CRAWLER_USER_AGENT = "PlacidWayAssessmentBot/1.0 (+https://github.com/M-Tayyab-AI/placidway-knowledge-chatbot)"
